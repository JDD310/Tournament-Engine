# Copy to .env and fill in. Never commit .env.
#
# Used by the backend during local development (copy to backend/.env) and by
# `docker run --env-file .env tournament-engine` (copy to the repo root).

# Required. Postgres connection string. Neon's "postgresql://..." URL can be
# pasted as-is; keep ?sslmode=require on it.
#   Local dev:          postgresql://user:password@localhost:5432/tournament_engine
#   Docker on macOS:    use host.docker.internal instead of localhost
#   Neon:               postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/tournament_engine

# Optional, Docker only. Run migrations when the container starts. Handy for a
# single local container; leave it off on Cloud Run and use the migration job
# in docs/deploy.md instead.
MIGRATE_ON_START=true

# Optional. Port the container listens on (Cloud Run sets this itself).
# PORT=8080

# Optional. Directory of the built frontend to serve next to the API. The
# Docker image sets it to /app/static; leave it unset for local development,
# where the Vite dev server serves the frontend.
# FRONTEND_DIST=
